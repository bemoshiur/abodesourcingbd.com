{
  "name": "abodesourcingbd-com",
  "version": "0.1.0",
  "description": "ABD Sourcing Bangladesh \u2014 garments buying & sourcing office marketing site.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fix-migration-imports.mjs && PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload run scripts/seed.mts",
    "migrate": "node scripts/fix-migration-imports.mjs && PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload migrate:create && node scripts/fix-migration-imports.mjs",
    "migrate:status": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload migrate:status",
    "admin:create": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload run scripts/create-admin.mts",
    "media:repair": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts NODE_OPTIONS=--no-deprecation payload run scripts/repair-media.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/plugin-cloud-storage": "3.88.0",
    "@payloadcms/storage-vercel-blob": "^3.88.0",
    "@vercel/blob": "2.3.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "payload": "^3.88.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
